# Copy to .env on the server and fill in. Never commit the real .env.

# Directory holding users.db. The container sets this to /data.
# APP_DATA_DIR=.

# The domain this portal serves. Required for /__auth single sign-on: it builds the
# login URL other subdomains redirect to, and limits where a login may return you.
BASE_DOMAIN=gehan.cloud

# Needed alongside BASE_DOMAIN so the session cookie reaches every subdomain.
# No leading dot: Tomcat validates this per RFC 6265 and rejects ".gehan.cloud"
# outright, which turns every login into a 500. Plain "gehan.cloud" already covers
# the subdomains. Leave this out entirely if you are not using /__auth.
SERVER_SERVLET_SESSION_COOKIE_DOMAIN=gehan.cloud

# Which networks count as "somewhere a lanOnly tile can reach". A visitor arriving
# over the internet shows up as their site's public address, so that is what goes
# here, not the 192.168 range. Sign in as an admin and open /users to see the
# address the app actually saw you arrive from.
#
# Only the beach tile is network-gated today, so this is the beach's public
# address. Note it is a home internet address and will change eventually: when it
# does the tile greys out until this is updated. Nothing is exposed by that, the
# tile just looks wrong.
TRUSTED_NETWORKS=65.84.61.185/32

# Username of the account created when the database is empty.
# APP_BOOTSTRAP_ADMIN=admin

# INFO by default. DEBUG is noisy and logs security internals.
# LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
