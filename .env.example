# Copy to .env on the server and fill in. Never commit the real .env.

# --- Deployment (read by docker-compose.yml, not by the app) ------------------

# The Docker network shared with cloudflared, so the tunnel can resolve this
# container by name. Create it once and attach the existing tunnel to it:
#
#   docker network create edge
#   docker network connect edge cloudflared
#
# EDGE_NETWORK=edge

# Which published image to run. Pin to a :sha-... tag to hold a known-good build
# and stop Watchtower moving you off it.
# IMAGE_TAG=latest

# Used by the optional Watchtower profile for its log timestamps.
# TZ=America/New_York

# The tunnel token does NOT go here. Everything in this file is handed to the app
# container, which has no use for it. For the optional `tunnel` profile, put it in
# .env.tunnel instead - a file of its own, gitignored, read only by cloudflared:
#
#   echo 'TUNNEL_TOKEN=...' > .env.tunnel
#
# Reusing the server's existing tunnel, which is the setup here, needs neither.

# --- Application ---------------------------------------------------------------

# Directory holding users.db. The container sets this to /data.
# APP_DATA_DIR=.

# The domain this portal serves. Required for /__auth single sign-on: it builds the
# login URL other subdomains redirect to, and limits where a login may return you.
BASE_DOMAIN=gehan.cloud

# Needed alongside BASE_DOMAIN so the session cookie reaches every subdomain.
# No leading dot: Tomcat validates this per RFC 6265 and rejects ".gehan.cloud"
# outright, which turns every login into a 500. Plain "gehan.cloud" already covers
# the subdomains. Leave this out entirely if you are not using /__auth.
SERVER_SERVLET_SESSION_COOKIE_DOMAIN=gehan.cloud

# Where to read the visitor's address from. Behind Cloudflare this must be
# CF-Connecting-IP. The edge APPENDS the real address to any X-Forwarded-For the
# visitor sent rather than replacing it, and the app resolves that header to its
# first entry - so without this a visitor can hand you any address they like and
# TRUSTED_NETWORKS below would believe it. CF-Connecting-IP is rewritten by the
# edge on every request and cannot be supplied by the visitor.
#
# This holds only while the tunnel is the sole route to the container. Do not
# publish port 8080 alongside it; docker-compose.yml deliberately does not.
#
# Leave unset when running locally, where there is no proxy to trust.
CLIENT_IP_HEADER=CF-Connecting-IP

# Which networks the Dashboard tile lights up on. Both houses point at the same
# private address, so this is just "am I in one of my houses?" - one list covers
# both, and the address itself picks the right dashboard.
#
# These are the PUBLIC addresses of each house, not their 192.168 ranges: loading
# gehan.cloud goes out to the internet and back, so you arrive looking like your
# router. To find one, sign in as an admin from that house and open /users - it
# shows the address the app saw you arrive from.
#
#   <beach public address>/32   the beach
#   <home public address>/32    read each off /users while standing there
#
# Until the home address is added the tile stays grey at home. Nothing is exposed
# by that; the tile just looks wrong. Same when either address rotates, which home
# internet addresses do.
TRUSTED_NETWORKS=

# The session cookie is marked Secure by default, so it is only ever sent over
# HTTPS. Set this to false only when testing over plain http on your own machine.
# SESSION_COOKIE_SECURE=true

# Username of the account created when the database is empty.
# APP_BOOTSTRAP_ADMIN=admin

# INFO by default. DEBUG is noisy and logs security internals.
# LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
