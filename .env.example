# Copy to .env on the server and fill in. Never commit the real .env.

# Shared secret for POST /api/share. Unset -> the endpoint returns 503.
SHARE_KEY=

# Signing key for API bearer tokens, 32+ characters.
# Unset -> a random key is generated per boot, so every token dies on redeploy.
#   openssl rand -base64 48
JWT_SECRET=

# Username of the account created when the database is empty.
# APP_BOOTSTRAP_ADMIN=admin

# INFO by default. DEBUG is noisy and logs security internals.
# LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
