{
  "name": "globle-data",
  "private": true,
  "description": "Builds the country list, distance matrix and display globe for the Globle app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build-data.mjs",
    "check": "node check-data.mjs && node check-rollcall.mjs",
    "check:i18n": "node check-i18n.mjs",
    "check:rollcall": "node check-rollcall.mjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "i18n-iso-countries": "7.14.0",
    "polylabel": "2.1.0",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "world-countries": "5.1.0"
  }
}
